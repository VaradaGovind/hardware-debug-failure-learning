{
  "include": [
    "src",
    "tests",
    "scripts",
    "experiments"
  ],
  "exclude": [
    "**/__pycache__",
    ".pytest_cache",
    ".git"
  ],
  "extraPaths": [
    ".",
    "src"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.12"
}
